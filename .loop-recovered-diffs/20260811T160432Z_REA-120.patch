+def _optional_plugin(manager: PluginManager, name: str):
+    """Look up a loaded plugin by name without raising if it's absent,
+    errored, or never configured (REA-120: the GitHub plugin is opt-in
+    via [plugins].enabled -- most of this module's callers need to
+    degrade gracefully, not treat a missing plugin as a hard failure
