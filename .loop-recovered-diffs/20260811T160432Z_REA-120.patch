+    def check_missing_prs(self) -> List[PRCreated]:
+        """REA-120: reconcile a stalled build->review handoff -- an
+        issue Linear says is in-review (`list_in_review()`), with its
+        branch already pushed to origin, but with zero GitHub PR ever
+        opened for that branch. This is exactly the REA-85 failure
+        mode: `_end_build` used to move an issue to In Review right
+        after pushing, with no atomic guarantee a PR followed (fixed
+        going forward in `pass_engine._end_build`, REA-120), so a
+        pre-existing gap between "Linear says in-review" and "a PR
+        exists" needs its own periodic sweep independent of any single
+        build pass.
+
+        No-ops entirely (returns `[]`) when no `github` plugin is
+        configured -- this check has nothing to reconcile against
+        without a PR host. For each affected issue: since the commit
+        and branch already exist and are safe to expose, auto-create
+        the missing PR (rather than merely alerting) and emit
+        `PRCreated`, mirroring what a human already had to do by hand
+        for REA-85."""
+        github = _optional_plugin(self.manager, "github")
+        if github is None:
+            return []
+        try:
+            linear = _linear_plugin(self.manager)
+            in_review = linear.list_in_review()
+        except PassEngineError:
+            return []
+
+        created: List[PRCreated] = []
+        base = None
+        for issue in in_review:
+            issue_id = issue.get("identifier")
+            if not issue_id:
+                continue
+            branch = branch_for_issue(issue_id, issue.get("title", ""))
+            if not branch:
+                continue
+
+            try:
+                existing = github.find_pr_for_branch(branch)
+            except Exception:  # noqa: BLE001 - one bad lookup must not break the sweep
+                continue
+            if existing:
+                continue  # already has a PR -- nothing to reconcile
+
+            code, out, _ = _run(["git", "ls-remote", "--heads", "origin", branch],
+                                 cwd=self.config.root, timeout=30)
+            has_branch = code == 0 and bool(out.strip())
+            if not has_branch:
+                continue  # branch not even pushed yet -- not this check's problem
+
+            if base is None:
+                base = default_branch(self.config)
+
+            title = issue.get("title") or f"{issue_id}"
+            try:
+                pr = github.create_pr(
