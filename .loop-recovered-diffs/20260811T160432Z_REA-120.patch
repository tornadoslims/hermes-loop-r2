+    def find_pr_for_branch(self, branch: str) -> Optional[dict]:
+        """Look up an open PR whose head is `branch` in this repo
+        (REA-120). Used by the reconciliation watchdog to detect a
+        stalled build->review handoff: a branch was pushed and Linear
+        says the issue is in-review, but no PR referencing that branch
+        was ever opened."""
+        owner = self._repo.split("/", 1)[0] if self._repo else None
+        head = f"{owner}:{branch}" if owner else branch
+        prs = self._call(
+            "GET",
+            f"/repos/{self._repo}/pulls",
+            params={"state": "open", "head": head, "per_page": 5},
+        )
+        for pr in prs or []:
+            if pr.get("head", {}).get("ref") == branch:
+                return {"pr_number": pr["number"], "url": pr["html_url"]}
+        return None
